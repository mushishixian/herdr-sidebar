#!/usr/bin/env python3
"""Send one raw request to the herdr socket API and print the JSON reply.

    herdr-rpc METHOD [PARAMS_JSON]
    herdr-rpc pane.focus '{"pane_id":"w1:p2"}'

Only for methods the herdr CLI does not wrap (pane.focus by id). The socket
path comes from HERDR_SOCKET_PATH, which herdr sets in every pane, hook and
action; outside herdr it is read from `herdr status server`.
"""
import json
import os
import socket
import subprocess
import sys


def socket_path():
    path = os.environ.get("HERDR_SOCKET_PATH")
    if path:
        return path
    herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
    out = subprocess.run([herdr, "status", "server"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("socket:"):
            return line.split(":", 1)[1].strip()
    sys.exit("herdr-rpc: no running herdr server")


def main():
    if len(sys.argv) not in (2, 3):
        sys.exit(__doc__.strip())
    params = json.loads(sys.argv[2]) if len(sys.argv) == 3 else {}
    request = {"id": "herdr-rpc", "method": sys.argv[1], "params": params}
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(10)
        sock.connect(socket_path())
        sock.sendall((json.dumps(request) + "\n").encode())
        reply = b""
        while not reply.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            reply += chunk
    text = reply.decode().strip()
    print(text)
    try:
        failed = "error" in json.loads(text)
    except ValueError:
        failed = True
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
