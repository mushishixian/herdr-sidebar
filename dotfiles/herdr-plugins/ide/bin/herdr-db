#!/usr/bin/env bash
# Open — or return to — this workspace's Database tab: harlequin, kept alive.
#
# Why a TAB and not herdr's popup placement: herdr allows exactly ONE popup per
# session (`ui_busy: a popup pane is already open`, verified live), and an
# unfocused popup is not in `pane list` at all, so a popup cannot be "left
# running and switched back to" — one kept-open DB popup would also break
# ctrl+q, ctrl+alt+f and ctrl+alt+q. A tab keeps the harlequin process, its
# result pane and its open query tabs alive, `plugin pane focus` switches back to
# it instantly, and the tab bar shows it.
#
# herdr's `plugin pane open` NEVER reuses an entrypoint — a second call opens a
# second tab (verified live: wV:t2 then wV:t3) — so this looks for the pane
# first and only creates a tab when there is none.
set -uo pipefail
bin=$(cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=lib.sh
. "$bin/lib.sh"

DB_LABEL=Database
ACTION=dotfiles-ide.db

[ -n "${cur_ws:-}" ] || die "no workspace context — bind this to a herdr key"

# The project the user is looking at: the caller pane's live cwd, not a stored one.
root=''
if [ -n "${cur_pane:-}" ]; then
  root=$(pane_field "$cur_pane" foreground_cwd)
  [ -n "$root" ] || root=$(pane_field "$cur_pane" cwd)
fi
[ -n "$root" ] || root=${PWD:-.}
root=$(project_root "$root")
[ -d "$root" ] || die "project directory not found: $root"

# Already open in this workspace? Focus it: the process and its state are there.
existing=$("$HERDR" pane list | jq -r --arg ws "$cur_ws" --arg lbl "$DB_LABEL" '
  first(.result.panes[]
    | select(.workspace_id == $ws and .label == $lbl)
    | .pane_id) // empty')
if [ -n "$existing" ]; then
  if ! "$HERDR" plugin pane focus "$existing" >/dev/null 2>&1; then
    focus_pane "$existing"
  fi
  exit 0
fi

command -v harlequin >/dev/null 2>&1 ||
  die "harlequin is not installed (run docs/install-herdr-ide.sh, or: uv tool install harlequin)"

# What it will connect to, so the toast can say it (and an empty answer is honest).
summary=$(HS_DB_ROOT=$root "$bin/db-pane" --summary 2>/dev/null) || summary=''

opened=$("$HERDR" plugin pane open \
  --plugin dotfiles-ide --entrypoint db \
  --placement tab --focus \
  --workspace "$cur_ws" --cwd "$root" \
  --env "HS_DB_ROOT=$root" 2>/dev/null) || die "could not open the Database pane"
pane=$(printf '%s' "$opened" | jq -r '.result.plugin_pane.pane.pane_id // empty')
[ -n "$pane" ] || die "the Database pane did not report its id"
tab=$(pane_field "$pane" tab_id)

# The new tab is `db`, not herdr's generated number.
[ -n "$tab" ] && "$HERDR" tab rename "$tab" db >/dev/null 2>&1
# The sidebar's tab.created hook docks an explorer into every new tab. In the DB
# tab that is a 32-column strip next to a full-width GUI, so snooze it exactly
# like the sidebar's own « button does (`src/snooze.rs`: one empty file per tab
# under the plugin's state dir) and close the copy that already docked. Both are
# best effort — the worst case is the sidebar coming back on the next focus.
snooze="${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr/plugins/herdr-sidebar}/snooze"
if [ -n "$tab" ]; then
  mkdir -p "$snooze" 2>/dev/null && : >"$snooze/${tab//:/_}" 2>/dev/null
  for _ in 1 2 3 4 5; do
    side=$(pane_with_label "$tab" Sidebar)
    [ -n "$side" ] || break
    "$HERDR" pane send-keys "$side" ctrl+q >/dev/null 2>&1
    sleep 0.4
  done
fi

if [ -n "$summary" ]; then
  tip "Database · $summary" "$ACTION"
else
  tip "Database · no connection found in $root" "$ACTION"
fi
