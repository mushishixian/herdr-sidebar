#!/usr/bin/env bash
# ide-agent-title PANE COMMAND — title the Agent pane after the agent COMMAND
# runs (border shows "◆ CLAUDE"); ide-agent-title --clear PANE — back to "Agent".
# Pane label stays "Agent" (scripts find it by label); only the title changes.
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
. "$here/lib.sh"

SOURCE=dotfiles-ide-agent

# Command word -> agent name. Extend here.
#
# This table is the ONLY place an agent becomes visible: the title it sets also
# carries `--display-agent`, which herdr-sidebar turns into the spaces rail's
# `$agents` value (`src/agent_tokens.rs`). herdr itself only detects the agents
# it ships an integration for (`herdr integration status`), so a CLI missing
# here has no name anywhere — herdr reports no `agent` for the pane and the
# rail shows nothing until this table names it (verified live with `codebuddy`:
# `--display-agent codebuddy` alone made the rail read `codebuddy`).
#
# Keys are the command/package word as typed (`codebuddy`, `npx @tencent-ai/…`
# resolves to the package's own binary name); the value is what the border and
# the rail show, so keep it short and lowercase.
declare -A AGENT_OF=(
  # Anthropic / OpenAI / Google
  [claude]=claude [claude-code]=claude
  [codex]=codex [codex-cli]=codex [openai-codex]=codex
  [gemini]=gemini [gemini-cli]=gemini
  [antigravity]=antigravity [antigravity-cli]=antigravity
  [jules]=jules
  # Cursor, GitHub, factory.ai, Devin, Hermes, Letta
  [cursor]=cursor [cursor-agent]=cursor
  [copilot]=copilot [gh-copilot]=copilot
  [droid]=droid [factory]=droid
  [devin]=devin
  [hermes]=hermes
  [letta]=letta [letta-code]=letta
  # Tencent / Alibaba / Moonshot / xAI / Mistral
  [codebuddy]=codebuddy [codebuddy-code]=codebuddy
  [qwen]=qwen [qwen-code]=qwen
  [qoder]=qoder [qodercli]=qoder [lingma]=lingma
  [kimi]=kimi [kimi-cli]=kimi [kimi-code]=kimi
  [grok]=grok [grok-cli]=grok
  [vibe]=vibe [mistral-vibe]=vibe
  # Everything else: OSS and smaller CLIs
  [opencode]=opencode
  [aider]=aider [aider-chat]=aider
  [pi]=pi [omp]=omp [oh-my-pi]=omp
  [amp]=amp [sourcegraph-amp]=amp
  [crush]=crush [charm-crush]=crush
  [goose]=goose [block-goose]=goose
  [kilo]=kilo [kilo-code]=kilo
  [cline]=cline
  [roo]=roo [roo-code]=roo
  [mastracode]=mastracode
  [openhands]=openhands [open-interpreter]=openhands [interpreter]=openhands
  [continue]=continue [cn]=continue
  [auggie]=augment [augment]=augment [augment-code]=augment
  [plandex]=plandex [codebuff]=codebuff [octofriend]=octofriend
  [gptme]=gptme [sweep]=sweep [smol]=smol [mods]=mods
  [iflow]=iflow [iflow-cli]=iflow
  [kiro]=kiro [kiro-cli]=kiro [trae]=trae
)

# Print the agent name for command line $1, or nothing. Splits on whitespace
# only (no eval): skips assignments and wrappers, then runs through package
# runners (npx pnpm dlx ...) to the package name.
agent_of() {
  local -a words
  local i n w base canon
  read -ra words <<<"${1:-}"
  n=${#words[@]}
  i=0
  while (( i < n )); do
    w=${words[i]}
    if [[ $w =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then i=$((i + 1)); continue; fi
    case $w in
      command|exec|noglob|builtin|nohup|time) i=$((i + 1)) ;;
      sudo) i=$((i + 1)); while (( i < n )) && [[ ${words[i]} == -* ]]; do i=$((i + 1)); done ;;
      env)
        i=$((i + 1))
        while (( i < n )); do
          case ${words[i]} in
            -u|-C|-S) i=$((i + 2)) ;;
            -*|*=*) i=$((i + 1)) ;;
            *) break ;;
          esac
        done ;;
      *) break ;;
    esac
  done
  (( i < n )) || return 0
  w=${words[i]}
  base=${w##*/}
  case $base in
    npx|bunx|pnpx|uvx|npm|pnpm|yarn)
      i=$((i + 1))
      if [[ $base == npm || $base == pnpm || $base == yarn ]]; then
        case ${words[i]:-} in dlx|exec) i=$((i + 1)) ;; *) return 0 ;; esac
      fi
      while (( i < n )) && [[ ${words[i]} == -* ]]; do i=$((i + 1)); done
      (( i < n )) || return 0
      w=${words[i]}
      base=${w##*/}
      ;;
  esac
  base=${base%%@*}
  canon=${AGENT_OF[$base]:-}
  [ -z "$canon" ] || printf '%s\n' "$canon"
  return 0
}

# Only when run, not when sourced for agent_of.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  if [ "${1:-}" = --clear ]; then
    pane=${2:-}
    [ -n "$pane" ] || exit 0
    "$HERDR" pane report-metadata "$pane" --source "$SOURCE" \
      --clear-title --clear-display-agent >/dev/null 2>&1 || true
    exit 0
  fi
  pane=${1:-}
  [ -n "$pane" ] || exit 0
  agent=$(agent_of "${2:-}")
  [ -n "$agent" ] || exit 0
  "$HERDR" pane report-metadata "$pane" --source "$SOURCE" \
    --title "◆ ${agent^^}" --display-agent "$agent" >/dev/null 2>&1 || true
fi
