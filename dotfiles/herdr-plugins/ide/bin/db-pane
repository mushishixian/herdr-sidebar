#!/usr/bin/env bash
# The "Database" pane: harlequin, the terminal DB GUI, connected from the project.
#
# ONE implementation of connection discovery, with three callers:
#   db-pane            the pane process itself: exec harlequin with the found args
#   db-pane --print    herdr-db asks what WOULD run (one arg per line)
#   db-pane --summary  one human line ("mysql · app_db @ 127.0.0.1") for a toast
#
# Precedence, first hit wins:
#   1. DATABASE_URL / DB_URL  (.env.local, then .env, then the real environment)
#   2. Laravel-style DB_CONNECTION + DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/…
#   3. a local SQLite file (database/database.sqlite, *.sqlite, *.sqlite3, *.db)
#   4. a database INI (`db.ini`: [section] host/user/passwd/db, 70+ databases on
#      this machine) — HS_DB_SECTION picks one outright, otherwise a picker
#   5. nothing -> harlequin with no arguments, i.e. its own connection picker
#
# Adapters differ, so the args do too: MySQL REFUSES a DSN ("Cannot provide a DSN
# to the MySQL adapter", harlequin_mysql/adapter.py) and wants --host/--database…
# while clickhouse and postgres take a URL and sqlite takes a path.
set -uo pipefail

root=${HS_DB_ROOT:-$PWD}

# Last KEY=VALUE in FILE, quotes stripped (a `.env` with CRLF or `export ` works).
envfile_value() { # key file
  local key=$1 file=$2 raw
  [ -f "$file" ] || return 1
  raw=$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n 1) || return 1
  [ -n "$raw" ] || return 1
  raw=${raw#*=}
  raw=${raw%$'\r'}
  case $raw in
    \"*\") raw=${raw#\"}; raw=${raw%\"} ;;
    \'*\') raw=${raw#\'}; raw=${raw%\'} ;;
  esac
  printf '%s\n' "$raw"
}

# A connection setting: .env.local overrides .env, which overrides the environment.
db_env() { # key
  local key=$1 v
  for file in "$root/.env.local" "$root/.env"; do
    v=$(envfile_value "$key" "$file") || v=''
    if [ -n "$v" ]; then
      printf '%s\n' "$v"
      return 0
    fi
  done
  printf '%s\n' "${!key:-}"
}

# URL -> U_SCHEME U_USER U_PASS U_HOST U_PORT U_DB. Percent-escapes are left
# alone: a password that needs them should be split into DB_* variables instead.
parse_url() { # url
  local url=$1 rest creds hostpart hp
  U_SCHEME='' U_USER='' U_PASS='' U_HOST='' U_PORT='' U_DB=''
  case $url in
    *://*)
      U_SCHEME=${url%%://*}
      rest=${url#*://}
      ;;
    sqlite:*)
      U_SCHEME=sqlite
      rest=${url#sqlite:}
      rest=${rest#//}
      ;;
    *) return 0 ;;
  esac
  U_SCHEME=${U_SCHEME%%+*} # mysql+pymysql -> mysql
  # A SQLite "URL" is just a path, so it must not be sliced at its slashes:
  # `sqlite:///abs/x.db` -> `/abs/x.db`, not `abs/x.db`.
  case $U_SCHEME in
    sqlite | file)
      U_DB=$rest
      [ "$U_DB" = ':memory:' ] || [ -n "$U_DB" ] || U_DB=''
      return 0
      ;;
  esac
  creds='' hostpart=$rest
  case $rest in
    *@*)
      creds=${rest%@*}
      hostpart=${rest##*@}
      ;;
  esac
  if [ -n "$creds" ]; then
    U_USER=${creds%%:*}
    case $creds in *:*) U_PASS=${creds#*:} ;; esac
  fi
  hostpart=${hostpart%%\?*}
  hostpart=${hostpart%%#*}
  U_DB=${hostpart#*/}
  [ "$U_DB" = "$hostpart" ] && U_DB=''
  hp=${hostpart%%/*}
  case $hp in
    *:*)
      U_PORT=${hp##*:}
      hp=${hp%:*}
      ;;
  esac
  U_HOST=$hp
}

ARGS=()
SUMMARY=''
push() { ARGS+=("$@"); }

# --host/--database… for the MySQL adapter, skipping empty values.
mysql_flags() { # host port database user password
  [ -n "$1" ] && push --host "$1"
  [ -n "$2" ] && push --port "$2"
  [ -n "$3" ] && push --database "$3"
  [ -n "$4" ] && push --user "$4"
  [ -n "$5" ] && push --password "$5"
  return 0
}

url=$(db_env DATABASE_URL)
[ -n "$url" ] || url=$(db_env DB_URL)
if [ -n "$url" ]; then
  parse_url "$url"
  case $U_SCHEME in
    sqlite | file)
      if [ -z "$U_DB" ] || [ "$U_DB" = ':memory:' ]; then
        push -a sqlite
        SUMMARY='sqlite · in memory'
      else
        push -a sqlite "$U_DB"
        SUMMARY="sqlite · $U_DB"
      fi
      ;;
    mysql | mariadb)
      push -a mysql
      mysql_flags "$U_HOST" "$U_PORT" "$U_DB" "$U_USER" "$U_PASS"
      SUMMARY="mysql · ${U_DB:-?} @ ${U_HOST:-localhost}"
      ;;
    postgres | postgresql | pgsql)
      push -a postgres "$url"
      SUMMARY="postgres · ${U_DB:-?}"
      ;;
    clickhouse)
      push -a clickhouse "$url"
      SUMMARY="clickhouse · ${U_DB:-?}"
      ;;
    duckdb)
      push -a duckdb "$U_DB"
      SUMMARY="duckdb · $U_DB"
      ;;
    *)
      SUMMARY="unknown scheme '$U_SCHEME' — pick a connection in harlequin"
      ;;
  esac
fi

if [ ${#ARGS[@]} -eq 0 ]; then
  conn=$(db_env DB_CONNECTION)
  host=$(db_env DB_HOST)
  port=$(db_env DB_PORT)
  db=$(db_env DB_DATABASE)
  user=$(db_env DB_USERNAME)
  pass=$(db_env DB_PASSWORD)
  case $conn in
    mysql | mariadb)
      push -a mysql
      mysql_flags "${host:-127.0.0.1}" "${port:-3306}" "$db" "$user" "$pass"
      SUMMARY="mysql · ${db:-?} @ ${host:-127.0.0.1}"
      ;;
    pgsql | postgres | postgresql)
      push -a postgres
      push "postgresql://${user}${pass:+:$pass}@${host:-127.0.0.1}:${port:-5432}/${db}"
      SUMMARY="postgres · ${db:-?} @ ${host:-127.0.0.1}"
      ;;
    clickhouse)
      push -a clickhouse
      push "clickhouse://${user}${pass:+:$pass}@${host:-127.0.0.1}:${port:-8123}/${db}"
      SUMMARY="clickhouse · ${db:-?} @ ${host:-127.0.0.1}"
      ;;
    sqlite)
      push -a sqlite "$db"
      SUMMARY="sqlite · ${db:-?}"
      ;;
    '') ;;
    *)
      SUMMARY="no adapter for DB_CONNECTION=$conn — pick a connection in harlequin"
      ;;
  esac
fi

# The machine's database INI: [section] host/user/passwd/db, no nesting, `#`
# comments, and the same section often appears twice (later wins).
# HS_DB_INI overrides the search; HS_DB_SECTION picks a section without asking.
ini=${HS_DB_INI:-}
if [ -z "$ini" ]; then
  for candidate in "$root/db.ini" "$root/.db.ini" "$root/../liexin_config/db.ini" \
    /data/www/liexin_config/db.ini; do
    if [ -f "$candidate" ]; then
      ini=$candidate
      break
    fi
  done
fi

declare -A INI_HOST=() INI_USER=() INI_PASS=() INI_DB=()
INI_ORDER=()
if [ -n "$ini" ] && [ -f "$ini" ]; then
  # shellcheck disable=SC1090
  while IFS='=' read -r key value; do
    case $key in
      '['*']')
        section=${key#[}
        section=${section%]}
        section=${section// /}
        case $section in
          '' | '['*']') section='' ;; # anything odd is not a section
        esac
        if [ -n "$section" ] && [ -z "${INI_HOST[$section]+set}" ]; then
          INI_ORDER+=("$section")
        fi
        ;;
      host | user | passwd | password | db | database)
        [ -n "$section" ] || continue
        value=${value%$'\r'}
        value=${value#\"}
        value=${value%\"}
        case $key in
          host) INI_HOST[$section]=$value ;;
          user) INI_USER[$section]=$value ;;
          passwd | password) INI_PASS[$section]=$value ;;
          db | database) INI_DB[$section]=$value ;;
        esac
        ;;
    esac
  # Only a LEADING `#` is a comment: these passwords contain `#`
  # (`liexin#zsyM`), so stripping to end-of-line would silently break every one.
  done < <(sed -e 's/^[[:space:]]*#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$ini" 2>/dev/null)
fi

# A chosen INI section -> the MySQL adapter's arguments.
ini_args() { # section
  local section=$1
  push -a mysql
  mysql_flags "${INI_HOST[$section]:-127.0.0.1}" '' "${INI_DB[$section]:-}" \
    "${INI_USER[$section]:-}" "${INI_PASS[$section]:-}"
  SUMMARY="mysql · ${INI_DB[$section]:-?} @ ${INI_HOST[$section]:-?} ($section)"
}

PICK_SUMMARY=''
[ ${#INI_ORDER[@]} -gt 0 ] && PICK_SUMMARY="${#INI_ORDER[@]} databases in $(basename "$ini")"

# Nothing declared yet: the project's own SQLite file beats the machine-wide
# database list, because it is about THIS project.
if [ ${#ARGS[@]} -eq 0 ]; then
  file=$(find "$root" -maxdepth 2 \
    \( -name node_modules -o -name vendor -o -name .git -o -name target \) -prune -o \
    -type f \( -name '*.sqlite' -o -name '*.sqlite3' -o -name '*.db' \) -print 2>/dev/null |
    head -n 1)
  if [ -n "$file" ]; then
    push -a sqlite "$file"
    SUMMARY="sqlite · ${file#"$root"/}"
  fi
fi

# An explicit HS_DB_SECTION wins over everything: it is the caller saying which
# database, e.g. `herdr plugin pane open … --env HS_DB_SECTION=db_cms`.
case ${HS_DB_SECTION:-} in
  '') ;;
  *)
    if [ -n "${INI_HOST[${HS_DB_SECTION:-}]+set}" ]; then
      ARGS=()
      SUMMARY=''
      ini_args "${HS_DB_SECTION:-}"
    else
      SUMMARY="no section [${HS_DB_SECTION:-}] in $ini"
    fi
    ;;
esac

# The picker. One keypress on the project's own database (its row is first, and
# Esc keeps it), or arrow down to any of the machine-wide ones — the DB tab is a
# deliberate "go look at a database" action, and this list is where you say
# which. Only for an interactive pane: the --print/--list/--summary modes must
# never block on a UI.
if [ -z "${1:-}" ] && [ ${#INI_ORDER[@]} -gt 0 ] && [ "${HS_DB_PICK:-1}" != 0 ] &&
  [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
  project_args=(${ARGS[@]+"${ARGS[@]}"})
  project_summary=$SUMMARY
  rows=()
  [ ${#project_args[@]} -gt 0 ] &&
    rows+=("$(printf '*project*\t%s\t' "$project_summary")")
  for section in "${INI_ORDER[@]}"; do
    rows+=("$(printf '%s\t%s@%s\t%s' "$section" "${INI_DB[$section]:-?}" \
      "${INI_HOST[$section]:-?}" "${INI_USER[$section]:-?}")")
  done
  chosen=$(printf '%s\n' "${rows[@]}" |
    fzf --height=100% --reverse --prompt='database> ' \
      --header="$(basename "$ini") — enter: open, esc: cancel" \
      --delimiter='\t' --with-nth='1,2' --nth='1,2' |
    cut -f1) || chosen=''
  case $chosen in
    '' | '*project*')
      # Esc or the project's own row: whatever detection already found.
      ARGS=(${project_args[@]+"${project_args[@]}"})
      SUMMARY=$project_summary
      ;;
    *)
      ARGS=()
      SUMMARY=''
      ini_args "$chosen"
      ;;
  esac
fi

case ${1:-} in
  --list)
    for section in "${INI_ORDER[@]}"; do
      printf '%s\t%s\t%s\t%s\n' "$section" "${INI_DB[$section]:-}" \
        "${INI_HOST[$section]:-}" "${INI_USER[$section]:-}"
    done
    exit 0
    ;;
  --print)
    for arg in ${ARGS[@]+"${ARGS[@]}"}; do printf '%s\n' "$arg"; done
    exit 0
    ;;
  --summary)
    # A picker is a real answer: the toast should say what it will show, not
    # "no connection found".
    [ -n "$SUMMARY" ] && printf '%s\n' "$SUMMARY"
    [ -n "$SUMMARY" ] || [ -z "$PICK_SUMMARY" ] || printf 'pick from %s\n' "$PICK_SUMMARY"
    exit 0
    ;;
esac

exec harlequin ${ARGS[@]+"${ARGS[@]}"}
