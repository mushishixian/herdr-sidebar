// Fresh editor (managed by herdr-sidebar/dotfiles). JSONC: comments and trailing commas are fine.
// Effective config: `fresh --cmd config show`.
{
  "version": 2,
  // Built-in "dark" is VS Code's Dark+ palette (#1e1e1e / #d4d4d4).
  "theme": "builtin://dark",
  // VS Code keymap: Ctrl+D = add next occurrence, Ctrl+/ = toggle comment.
  // Everything else falls through to Fresh's default map (F12, Shift+F12...).
  "active_keybinding_map": "vscode",

  // herdr is the orchestrator here: no Fresh workspace dock, and the
  // herdr-ide script picks one named daemon per project.
  "orchestrator_mode": false,
  "plugins": {
    "orchestrator": { "settings": { "autoOpenDock": "never" }, "enabled": true },
    "welcome_screen": { "enabled": true, "settings": { "showOnStartup": true } },
    // 0.5.3 的 git_statusbar 在每次状态栏刷新时 spawn 一次 `git rev-parse`，
    // 实测 ~40 次/秒/编辑器（日志 spawn_process_start: plugin='git_statusbar'），
    // 是空转 CPU 和 900 MB 级日志的主要来源。关掉只少一个状态栏分支名。
    "git_statusbar": { "enabled": false },
  },

  "editor": {
    "restore_previous_session": true,
    "trim_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "mouse_hover_enabled": true,
    "smooth_scroll": false,
    "rainbow_indentation": true,
  },

  // herdr-sidebar is the explorer; don't pop Fresh's own tree open.
  "file_explorer": {
    "auto_open_on_last_buffer_close": false,
  },

  // OSC 52 reaches the Windows clipboard through the terminal.
  "clipboard": {
    "use_osc52": true,
    "use_system_clipboard": true,
  },

  // Ctrl+Alt+O: git history of the selected lines, in a herdr popup.
  // (Not Ctrl+Alt+H: terminals send Ctrl+H as Backspace.)
  // (plugins/git_line_history.ts + the patched herdr-sidebar).
  "keybindings": [
    { "key": "o", "modifiers": ["ctrl", "alt"], "action": "git_line_history" },

    // Ctrl+Alt+Y / L / A: share the selected lines (plugins/selection_share.ts).
    // Copy the text, copy "<path>:<lines>" + a code block, or send that
    // reference to the IDE's Agent pane (herdr-plugins/ide/bin/fresh-to-agent).
    { "key": "y", "modifiers": ["ctrl", "alt"], "action": "selection_copy_text" },
    { "key": "l", "modifiers": ["ctrl", "alt"], "action": "selection_copy_reference" },
    { "key": "a", "modifiers": ["ctrl", "alt"], "action": "selection_send_to_agent" },

    // Ctrl+Tab: jump to the previously used open tab; again = back
    // (plugins/selection_share.ts). Only while editing ("when": "normal").
    // Windows Terminal binds Ctrl+Tab to its own "next tab": unbind it there.
    { "key": "tab", "modifiers": ["ctrl"], "action": "recent_tab", "when": "normal" },

    // Alt+C / I / M: accept current / incoming / both of the merge conflict at
    // the cursor; Alt+D next, Alt+Shift+D previous (plugins/selection_share.ts,
    // "Inline merge conflicts"). Free in Fresh's default keymap: Alt+1/2/3 are
    // bookmarks, Alt+N/P find-selection, Alt+Shift+N/P sidebar sections.
    { "key": "c", "modifiers": ["alt"], "action": "conflict_accept_current", "when": "normal" },
    { "key": "i", "modifiers": ["alt"], "action": "conflict_accept_incoming", "when": "normal" },
    { "key": "m", "modifiers": ["alt"], "action": "conflict_accept_both", "when": "normal" },
    { "key": "d", "modifiers": ["alt"], "action": "conflict_next", "when": "normal" },
    { "key": "d", "modifiers": ["alt", "shift"], "action": "conflict_prev", "when": "normal" },

    // LSP navigation: Alt+Shift+Q definition, Alt+Shift+W references, Alt+O the
    // document-symbol list ("Go to LSP Symbol", bundled plugin lsp_navigation).
    // alt+shift, not alt+q/w: herdr owns alt+w (lazygit popup) and hands keys out
    // before the pane's program sees them. F12 / Shift+F12 / Ctrl+F12 stay as
    // Fresh's built-ins (definition / references / implementation).
    // Ctrl+Shift+<letter> is not an option: without the kitty protocol the
    // terminal sends the same bytes as plain Ctrl+<letter> (Ctrl+Shift+O == Ctrl+O).
    // `goto_lsp_symbol` is a plugin action and binds directly — never wrap it in a
    // plugin that runCommands it by name (see docs/herdr-ide.md, Gotchas).
    { "key": "q", "modifiers": ["alt", "shift"], "action": "lsp_goto_definition", "when": "normal" },
    { "key": "w", "modifiers": ["alt", "shift"], "action": "lsp_references", "when": "normal" },
    { "key": "o", "modifiers": ["alt"], "action": "goto_lsp_symbol", "when": "normal" },
    { "key": "f12", "modifiers": ["shift"], "action": "lsp_references", "when": "normal" },
  ],

  // Language servers (installed by dotfiles/install-lsp.sh). An entry is merged
  // over Fresh's built-in table, so only the switches are set here. A server
  // that auto-starts but is missing opens its log as a tab.
  //
  // `process_limits` caps each server's memory/CPU share. Fresh has no global
  // default, so every language repeats it; a runaway server is otherwise
  // unbounded. Keep this block in sync with the live config — install.sh
  // symlinks this file over ~/.config/fresh/config.json.
  "lsp": {
    "markdown": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    "go": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    "rust": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    "dart": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    // phpactor needs PHP >= 8.2 but the default `php` is 7.2, so it runs
    // through ~/.local/bin/phpactor-lsp, which picks a suitable CLI.
    "php": { "command": "phpactor-lsp", "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    "javascript": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    "typescript": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    "json": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
    "bash": { "enabled": true, "auto_start": true, "process_limits": { "max_memory_percent": 50, "max_cpu_percent": 90, "enabled": true } },
  },
}
