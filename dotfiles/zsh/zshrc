# ~/.zshrc (managed by herdr-sidebar/dotfiles — machine-only bits go in ~/.zshrc.local)

export PATH="$HOME/.local/bin:$PATH"
# rustup (installed by herdr-sidebar/build.sh where apt's Rust is too old) wins over apt's.
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"
export EDITOR=fresh VISUAL=fresh
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
export BAT_CONFIG_PATH="$HOME/.config/bat/config"
# Open URLs in the Windows browser (herdr link clicks, CLIs that print logins).
command -v wsl-open >/dev/null && export BROWSER=wsl-open

# ── History ────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS \
       HIST_IGNORE_SPACE HIST_FIND_NO_DUPS
setopt AUTO_CD INTERACTIVE_COMMENTS

# ── Completion (herdr's completion is generated into ~/.zfunc) ─────────
fpath=(~/.zfunc $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── Keys: VS Code-ish line editing ─────────────────────────────────────
bindkey -e
bindkey '^[[1;5C' forward-word      # Ctrl+Right
bindkey '^[[1;5D' backward-word     # Ctrl+Left
bindkey '^[[3~'   delete-char       # Delete
bindkey '^[[H'    beginning-of-line # Home
bindkey '^[[F'    end-of-line       # End

# ── Tools ──────────────────────────────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
command -v fzf      >/dev/null && source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
export FZF_DEFAULT_OPTS='--layout=reverse --height=40% --border'

# ── Aliases ────────────────────────────────────────────────────────────
# --hyperlink makes every name Ctrl+clickable in herdr (files open in Fresh).
alias ls='eza --group-directories-first --hyperlink'
alias ll='eza -l --git --group-directories-first --hyperlink'
alias la='eza -la --git --group-directories-first --hyperlink'
alias lt='eza --tree --level=2 --hyperlink'
alias l='ll'
alias grep='grep --color=auto'
alias cat='bat --paging=never'
alias lg='lazygit'
alias e='fresh-open'                  # e src/main.rs:42 -> the IDE's Fresh
alias ide='herdr-ide'                 # build the IDE layout in this tab

# ── pnpm ───────────────────────────────────────────────────────────────
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# ── Local overrides, then plugins (syntax highlighting must be last) ──
# The installer ADOPTS a machine's pre-existing ~/.zshrc here rather than
# replacing it, so this line is what keeps that machine's aliases, PATHs and
# prompt alive — keep it. It stays ABOVE the plugin sources because
# zsh-syntax-highlighting must be sourced last; a personal rc that sources its
# own copy would break that ordering (drop it from the personal file instead).
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
