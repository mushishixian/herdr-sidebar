# ~/.zshrc (managed by herdr-sidebar/dotfiles — machine-only bits go in ~/.zshrc.local)

export PATH="$HOME/.local/bin:$PATH"
# rustup (installed by herdr-sidebar/build.sh where apt's Rust is too old) wins over apt's.
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"
export EDITOR=fresh VISUAL=fresh
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
export BAT_CONFIG_PATH="$HOME/.config/bat/config"
# Open URLs in the Windows browser (herdr link clicks, CLIs that print logins).
command -v wsl-open >/dev/null && export BROWSER=wsl-open

# ── History ────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS \
       HIST_IGNORE_SPACE HIST_FIND_NO_DUPS
setopt AUTO_CD INTERACTIVE_COMMENTS

# ── Completion (herdr's completion is generated into ~/.zfunc) ─────────
fpath=(~/.zfunc $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── Keys: VS Code-ish line editing ─────────────────────────────────────
bindkey -e
bindkey '^[[1;5C' forward-word      # Ctrl+Right
bindkey '^[[1;5D' backward-word     # Ctrl+Left
bindkey '^[[3~'   delete-char       # Delete
bindkey '^[[H'    beginning-of-line # Home
bindkey '^[[F'    end-of-line       # End

# ── Tools ──────────────────────────────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
command -v fzf      >/dev/null && source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
export FZF_DEFAULT_OPTS='--layout=reverse --height=40% --border'

# ── Prompt follows branch switches made outside this shell ─────────────
# A prompt already on screen keeps the old branch when the branch is switched
# from elsewhere (a sidebar popup, lazygit, an agent in another pane) until Enter.
# zsh's sched runs while the shell idles at the prompt, so a 1 s tick compares the
# repo's HEAD file and redraws on a change; zle reset-prompt keeps a half-typed
# line. Reading a file forks nothing, so the tick costs nothing measurable.
if [[ -o interactive ]]; then
  zmodload zsh/sched 2>/dev/null
  autoload -Uz add-zsh-hook
  typeset -g _prompt_head_file='' _prompt_head_sig=''
  # Nearest .git above $PWD -> the HEAD file to watch ('' = not in a repo).
  # A .git FILE (linked worktree, submodule) reads "gitdir: <path>", relative to its dir.
  _prompt_head_resolve() {
    local d=$PWD gd
    _prompt_head_file=''
    while :; do
      if [[ -d $d/.git ]]; then _prompt_head_file=$d/.git/HEAD; break; fi
      if [[ -f $d/.git ]]; then
        gd=$(<$d/.git); gd=${gd#gitdir: }
        [[ $gd != /* ]] && gd=$d/$gd
        _prompt_head_file=$gd/HEAD; break
      fi
      [[ $d == / ]] && break
      d=${d:h}
    done
    _prompt_head_sig=''
    [[ -n $_prompt_head_file && -r $_prompt_head_file ]] && _prompt_head_sig=$(<$_prompt_head_file)
  }
  _prompt_head_tick() {
    local s=''
    [[ -n $_prompt_head_file && -r $_prompt_head_file ]] && s=$(<$_prompt_head_file)
    if [[ $s != $_prompt_head_sig ]]; then
      _prompt_head_sig=$s
      zle && zle reset-prompt
    fi
    sched +1 _prompt_head_tick
  }
  # Re-sourcing this file must not stack a second tick: drop the old entries first.
  typeset -a _ph_idx=(); _ph_line=
  for _ph_line in ${(f)"$(sched 2>/dev/null)"}; do
    [[ $_ph_line == *_prompt_head_tick* ]] || continue
    _ph_idx+=( ${${(z)_ph_line}[1]} )   # "  1 Wed Oct ..." -> 1
  done
  for _ph_line in ${(On)_ph_idx}; do sched -$_ph_line; done
  unset _ph_idx _ph_line
  add-zsh-hook chpwd _prompt_head_resolve
  _prompt_head_resolve
  _prompt_head_tick
fi

# ── Aliases ────────────────────────────────────────────────────────────
# --hyperlink makes every name Ctrl+clickable in herdr (files open in Fresh).
alias ls='eza --group-directories-first --hyperlink'
alias ll='eza -l --git --group-directories-first --hyperlink'
alias la='eza -la --git --group-directories-first --hyperlink'
alias lt='eza --tree --level=2 --hyperlink'
alias l='ll'
alias grep='grep --color=auto'
alias cat='bat --paging=never'
alias lg='lazygit'
alias e='fresh-open'                  # e src/main.rs:42 -> the IDE's Fresh
alias ide='herdr-ide'                 # build the IDE layout in this tab

# ── pnpm ───────────────────────────────────────────────────────────────
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# ── Local overrides, then plugins (syntax highlighting must be last) ──
# This file IS ~/.zshrc on every machine (the installer replaces it, keeping the
# old one in ~/.dotfiles-backup). Anything that cannot be identical everywhere —
# SDK paths, work aliases, a different prompt — belongs in ~/.zshrc.local, which
# is machine-local and never managed by the repo. Keep this source line ABOVE the
# plugin sources: zsh-syntax-highlighting must be sourced last, so an overlay
# that sources its own copy breaks the ordering (drop it there, not here).
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# bun completions
[ -s "/home/xian/.bun/_bun" ] && source "/home/xian/.bun/_bun"
